    {
      "cell_type": "code",
      "source": [
        "# Criando uma cópia do data frame original para ser limpo, mas garantir a integridade dos dados originais\n",
        "\n",
        "df_limpo = df_bruto.copy()"
      ],
      "metadata": {
        "id": "nttKnfX37cVq"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Tratamento de valores nulos no data set\n",
        "\n",
        "df_limpo['children'] = df_limpo['children'].fillna(df_limpo['children'].mode()[0]) # Usando moda para preencher com o valor mais provável de acordo com o dataset\n",
        "\n",
        "df_limpo = df_limpo[df_limpo['adults'] != 0] # Não é possível um reserva sem adulto. Como eram poucas linhas com esse problema, elas foram dropadas\n",
        "\n",
        "df_limpo['country'] = df_limpo['country'].fillna('Unknown') # País ausente pode ser relevante para análises futuras, portanto essa informação foi preservada\n",
        "\n",
        "df_limpo['agent'] = pd.to_numeric(df_limpo['agent'].fillna(-1)) # Agente -1 significa que o cliente não tem um agente de viagens\n",
        "\n",
        "df_limpo['adr'] = df_limpo['adr'].apply(lambda x: x / 10 if x > 1000 else x) # Tratamento de outliers nos preços por diária\n",
        "\n",
        "df_limpo['is_corporate'] = df_limpo['company'].notnull().astype(int) # Ter ou não uma compania de viagens é relevante. Mas como a maioria não é, qual a compania se torna irrelevante\n",
        "df_limpo.drop(columns = ['company'], inplace = True) # das 119 mil células 112 mil são nulas, logo não há informações o bastante para se trabalhar nessa coluna"
      ],
      "metadata": {
        "id": "JZ250hE06Dyz"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Criando novas colunas\n",
        "  # Criação de uma coluna que registra quando os clientes chegaram no hotel e removendo as 3 colunas que faziam esse papel.\n",
        "  # Objetivo: melhorar legibilidade e análises futuras\n",
        "\n",
        "df_limpo['arrival_date'] = pd.to_datetime(\n",
        "    dict(\n",
        "        year = df_bruto['arrival_date_year'],\n",
        "        month = pd.to_datetime(df_bruto['arrival_date_month'], format = '%B').dt.month,\n",
        "        day = df_bruto['arrival_date_day_of_month']\n",
        "    )\n",
        ")\n",
        "\n",
        "df_limpo.drop(columns = ['arrival_date_year', 'arrival_date_month', 'arrival_date_day_of_month'], inplace=True)\n",
        "\n",
        "  # Criação de uma coluna que exibe o total de hóspedes\n",
        "\n",
        "df_limpo['total_guests'] = df_limpo['adults'] + df_limpo['children'] + df_limpo['babies']\n",
        "df_limpo['total_guests_clipped'] = df_limpo['total_guests'].clip(upper = 12) # No dataset existem outliers que não podem ser descartados, pois ele não oferece informações o suficiente para decidir se são ou não erros\n",
        "\n",
        "df_limpo['stay_nights'] = df_limpo['stays_in_weekend_nights'] + df_limpo['stays_in_week_nights']\n",
        "\n",
        "df_limpo['right_room'] = df_limpo.apply(lambda x: True if x['assigned_room_type'] == x['reserved_room_type'] else False, axis = 1)"
      ],
